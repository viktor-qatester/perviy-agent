# Канал отчёта: только Telegram
NOTIFY_VIA=telegram

# Локальное расписание бота (нужен python src/main.py --bot).
# Основной отчёт пн/пт 05:00 — GitHub Actions; оставьте false, иначе будет дубль.
SCHEDULE_ENABLED=false
SCHEDULE_DAYS=mon,fri
SCHEDULE_TIME=05:00
TIMEZONE=Europe/Moscow

# === Gmail (не используется при NOTIFY_VIA=telegram) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# EMAIL_USER=
# EMAIL_APP_PASSWORD=
# EMAIL_FROM=
# EMAIL_TO=

# === Telegram ===
# Ссылка t.me/qa_warrior — это КАНАЛ, не токен. Нужны два значения:
# 1) TELEGRAM_BOT_TOKEN — создайте бота у @BotFather (/newbot)
# 2) TELEGRAM_CHAT_ID — ваш личный chat_id (@userinfobot) ИЛИ @qa_warrior если бот — админ канала
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Канал для публикации одобренного дайджеста (бот — админ канала)
# @channel_username или -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=

# === LLM (облако, без локальных моделей) ===
# Провайдер: deepseek | openai | gemini
LLM_PROVIDER=deepseek
LLM_ENABLED=true

# DeepSeek (по умолчанию, OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (если LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini (если LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Поведение
DRY_RUN=true
DIGEST_DAYS_AHEAD=7

# v0.2: интерактивный бот (support + HITL)
#   python src/main.py --bot
# Для кнопок ✅/✏️/❌ при --send бот должен быть запущен (--bot)

# v0.3: Telegram RSS (@belarusitwant)
TELEGRAM_RSS_ENABLED=true
TELEGRAM_RSS_BELARUSITWANT_URL=https://rsshub.rssforever.com/telegram/channel/belarusitwant

# v0.3: rabota.by — QA Trainee/Junior
RABOTA_BY_ENABLED=true
RABOTA_BY_AREA=1002
RABOTA_BY_MAX_RESULTS=30

# v0.4: Habr Career — QA remote intern/junior
HABR_CAREER_ENABLED=true
HABR_CAREER_MAX_RESULTS=30
