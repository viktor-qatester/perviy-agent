# Только почта — достаточно для автономного дайджеста (Telegram не нужен)
NOTIFY_VIA=email

# Расписание (для Планировщика заданий Windows): запуск в 05:00, чтение ~06:00
SCHEDULE_RUN_TIME=05:00
SCHEDULE_TIMEZONE=Europe/Minsk

# === Gmail ===
# Обычный пароль от Gmail НЕ подходит — нужен «Пароль приложения»:
# Google Account -> Безопасность -> Двухэтапная аутентификация -> Пароли приложений
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_USER=staverviktor17@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_FROM=staverviktor17@gmail.com
EMAIL_TO=staverviktor17@gmail.com

# === Telegram ===
# Ссылка t.me/qa_warrior — это КАНАЛ, не токен. Нужны два значения:
# 1) TELEGRAM_BOT_TOKEN — создайте бота у @BotFather (/newbot)
# 2) TELEGRAM_CHAT_ID — ваш личный chat_id (@userinfobot) ИЛИ @qa_warrior если бот — админ канала
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM (позже)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Поведение
DRY_RUN=true
DIGEST_DAYS_AHEAD=7
